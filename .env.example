# PowerShell does not auto-load this file; set environment variables explicitly.
DMSG_MODEL_ENABLED=1
DMSG_SYSTEMONE_ENDPOINT=http://127.0.0.1:8008/v1/systemone
DMSG_MODEL_ID=trillionlabs/Zoro-1
DMSG_SEND_MODEL_FIELD=1
DMSG_REQUIRE_MODEL_ECHO=1
DMSG_MODEL_TIMEOUT_S=20
# Zoro (without -1) generation is a separate baseline, never a typed-head substitute.
# No credentials in this package. Authenticate with the normal provider client locally.


# Optional Jev 1.14 API shadow (not free). NEVER COMMIT REAL API KEYS.
# Separate from Zoro loopback. Do NOT enable without provider credits + approved budget.
TYPESAFE_API_KEY=
DMSG_JEV_LIVE_ENABLE=0
DMSG_JEV_SPEND_ACK=
# If charged execution is explicitly authorized, SPEND_ACK must be I_ACKNOWLEDGE_CHARGES
